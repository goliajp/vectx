{
  "name": "vectx",
  "version": "0.0.1",
  "description": "A descriptive language for AI-driven vector graphics — logos, UI, print, web, app, games. Designed for LLMs to both generate and understand.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "vector",
    "svg",
    "dsl",
    "ai",
    "llm",
    "intent-recovery",
    "graphics"
  ],
  "author": "GOLIA K.K.",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^5.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.2",
    "vite": "^8.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  }
